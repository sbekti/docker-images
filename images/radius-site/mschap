mschap {
    use_mppe = yes
    require_encryption = yes
    require_strong = yes
    with_ntdomain_hack = yes
    ntlm_auth = "/usr/local/bin/ntlm_auth_proxy %{mschap:User-Name} %{%{mschap:NT-Domain}:-$ENV{RADIUS_WINBIND_DOMAIN}} %{mschap:Challenge} %{mschap:NT-Response}"
    ntlm_auth_timeout = 3
}
