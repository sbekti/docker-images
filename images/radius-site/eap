eap {
    default_eap_type = peap

    tls-config tls-common {
        private_key_file = /run/radius-site-eap/server.key
        certificate_file = /run/radius-site-eap/server.pem
        fragment_size = 1024
        include_length = yes
        tls_min_version = "1.2"
        tls_max_version = "1.2"
    }

    peap {
        tls = tls-common
        default_eap_type = mschapv2
        copy_request_to_tunnel = no
        use_tunneled_reply = yes
        virtual_server = inner-tunnel
    }

    mschapv2 {
    }
}
