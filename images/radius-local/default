server default {
    listen {
        type = auth
        ipaddr = $ENV{RADIUS_LISTEN_ADDRESS}
        port = $ENV{RADIUS_LISTEN_PORT}
    }

    authorize {
        if (&EAP-Message) {
            update control {
                Tmp-String-0 := "eap"
            }
            eap
        }
        else {
            update reply {
                Tunnel-Type := VLAN
                Tunnel-Medium-Type := IEEE-802
                Tunnel-Private-Group-Id := "$ENV{RADIUS_DEFAULT_VLAN}"
            }
            update control {
                Tmp-String-0 := "registered_mac"
            }
            mab_users
            if (noop) {
                update control {
                    Auth-Type := Accept
                    Tmp-String-0 := "unknown_mac"
                }
            }
            else {
                pap
            }
        }
    }

    authenticate {
        Auth-Type Accept {
            accept
        }
        Auth-Type PAP {
            pap {
                reject = 1
            }
            if (reject) {
                update control {
                    Tmp-String-0 := "credential_mismatch"
                }
                update reply {
                    Tunnel-Private-Group-Id := "$ENV{RADIUS_DEFAULT_VLAN}"
                }
                accept
            }
        }
        eap
    }

    post-auth {
        if (&reply:Tunnel-Private-Group-Id) {
            update reply {
                Mikrotik-Wireless-VLANID := &reply:Tunnel-Private-Group-Id
                Mikrotik-Wireless-VLANID-Type := 0
            }
        }

        radius_auth {
            fail = 1
        }
        ok

        Post-Auth-Type REJECT {
            eap
            radius_auth {
                fail = 1
            }
            ok
        }
    }
}
