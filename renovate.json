{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["dockerfile", "github-actions", "pip_requirements"],
  "dependencyDashboard": true,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "separateMinorPatch": true,
  "timezone": "America/New_York",
  "packageRules": [
    {
      "description": "Automerge grouped patch updates after validation",
      "matchUpdateTypes": ["patch"],
      "groupName": "all patch dependencies",
      "automerge": true
    },
    {
      "description": "Group minor updates for manual review on Fridays",
      "matchUpdateTypes": ["minor"],
      "groupName": "all minor dependencies"
    },
    {
      "description": "Create separate major upgrade PRs on Fridays",
      "matchUpdateTypes": ["major"],
      "commitMessageAction": "upgrade",
      "commitMessageSuffix": "(major)"
    }
  ],
  "schedule": ["* * * * 5"],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
